# Copy this file to .env.local for local development, and set the same keys
# (with production values) in Vercel → Project → Settings → Environment Variables.

# ── Local development defaults ────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# NEXT_PUBLIC_SOCKET_URL=http://localhost:8080

# ── Production (Vercel) ───────────────────────────────────────────────────
# Backend API origin — the public URL of the hosted Express server
# (no trailing slash). Read at BUILD time by next.config.ts for the
# /api/v1/* rewrites, so set it in Vercel BEFORE building.
# NEXT_PUBLIC_API_URL=https://your-api-host.example.com/api/v1

# Socket.IO origin — same API host, for real-time chat / OPD queue updates.
# NEXT_PUBLIC_SOCKET_URL=https://your-api-host.example.com
