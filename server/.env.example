# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── PostgreSQL (required) ─────────────────────────────────────────────────
# Runtime connection (Prisma driver adapter).
DATABASE_URL=postgresql://user:password@host:5432/hospital?sslmode=require
# Direct connection used by `prisma db push` / `migrate` — required if the
# main URL goes through PgBouncer/connection pooling.
DIRECT_URL=postgresql://user:password@host:5432/hospital?sslmode=require

# ── MongoDB — optional (chat / patient-chat features) ─────────────────────
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/hospital

# ── Redis — optional (caching / rate limiting) ────────────────────────────
# REDIS_URL=rediss://user:password@host:6379

# ── Better Auth (required) ────────────────────────────────────────────────
# Must be at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-long-random-string-32-chars-minimum
# The PUBLIC https URL of the API host (no trailing slash).
BETTER_AUTH_URL=https://your-api-host.example.com

# ── CORS (required) ───────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API.
# Must include the Vercel app URL (and localhost for dev).
CLIENT_URL=https://your-app.vercel.app,http://localhost:3000

# ── Cloudinary — required for real file storage ───────────────────────────
# Without all three, the uploads module falls back to its local stub.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Hugging Face — optional (Hospital Assistant chatbot) ──────────────────
# HUGGINGFACE_API_KEY=hf_...
# HUGGINGFACE_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct:fastest
